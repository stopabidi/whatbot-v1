# Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# RAG API
RAG_API_URL=http://127.0.0.1:8002
RAG_API_KEY=generate_with_openssl_rand_hex_32
DOCUMENTS_DIR=/app/documents
STORAGE_DIR=/app/storage
CHROMA_DIR=/app/chroma_db

# Embedding model
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DEVICE=cuda

# RAG settings
FILE_OFFER_THRESHOLD=0.35

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_UPLOAD=5
RATE_LIMIT_REBUILD=1

# vLLM / llama-swap
LLAMA_SWAP_URL=http://localhost:8080
LLAMA_MODEL=/path/to/your/model

# Dashboard
DASHBOARD_API_KEY=generate_with_openssl_rand_hex_32

# Public URL for document sharing
PUBLIC_URL=http://localhost:3000

# Bot
BOT_NAME=AskJoe, Document Assistant
WELCOME_MESSAGE=Hello! I help answer questions about the published research.
