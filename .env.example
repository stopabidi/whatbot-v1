# Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
# Set to 'true' to skip webhook signature verification (dev only)
# TWILIO_SKIP_SIGNATURE_CHECK=true

# RAG API
RAG_API_URL=http://127.0.0.1:8002
RAG_API_KEY=generate_with_openssl_rand_hex_32
DOCUMENTS_DIR=/app/documents
STORAGE_DIR=/app/storage
CHROMA_DIR=/app/chroma_db

# Embedding model
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_DEVICE=cuda

# RAG settings
FILE_OFFER_THRESHOLD=0.35

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_UPLOAD=5
RATE_LIMIT_REBUILD=1

# llama-server
LLAMA_SWAP_URL=http://your-server-ip:8080
LLAMA_SWAP_MODEL=gemma-4-E4B
LLAMA_MODEL=/path/to/model.gguf

# Dashboard
DASHBOARD_API_KEY=generate_with_openssl_rand_hex_32

# Public URL for document sharing (Tailscale, public domain, etc.)
PUBLIC_URL=https://your-domain.com

# Bot
BOT_NAME=AskJoe, Document Assistant
WELCOME_MESSAGE=Hello! I help answer questions about the published research.
